{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "RabbitMq": {
    "ExchangeEntrada": "icarus.input",
    "ExchangeSaida": "icarus.output",
    "RoutingKeyOnboarding": "onboarding",
    "FilaResultadoOnboarding": "icarus.output.onboarding",
    "FilaResultadoOnboardingDlq": "icarus.output.onboarding.dlq",
    "MaxTentativas": 3
  },
  "AllowedHosts": "*"
}
