###############################################################################
# Normaliza fim de linha para evitar diffs espúrios entre Windows/Linux/macOS.
###############################################################################
* text=auto eol=lf

*.cs      text diff=csharp
*.csproj  text
*.sln     text
*.slnx    text
*.json    text
*.md      text
*.yml     text
*.yaml    text

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
